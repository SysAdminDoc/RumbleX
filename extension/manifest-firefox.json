{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "3.51.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "SysAdminDoc",
  "homepage_url": "https://github.com/SysAdminDoc/RumbleX",
  "icons": {
    "16": "icons/icon-16x16.png",
    "32": "icons/icon-32x32.png",
    "48": "icons/icon-48x48.png",
    "128": "icons/icon-128x128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "contextMenus",
    "alarms",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "*://*.rumble.com/*",
    "*://a.ads.rmbl.ws/*",
    "*://imasdk.googleapis.com/*",
    "*://s0.2mdn.net/*",
    "*://pagead2.googlesyndication.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googleadservices.com/*",
    "*://*.1a-1791.com/*",
    "*://*.rumble.cloud/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rumblex@sysadmindoc",
      "strict_min_version": "109.0",
      "update_url": "https://sysadmindoc.github.io/RumbleX/updates.json"
    }
  },
  "background": {
    "scripts": ["browser-polyfill.js", "settings-schema.js", "ad-blocker.js", "archive-fs.js", "background.js"]
  },
  "content_security_policy": "script-src 'self'; object-src 'self'; base-uri 'self'",
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16x16.png",
      "32": "icons/icon-32x32.png"
    },
    "default_title": "__MSG_actionTitle__",
    "default_popup": "pages/popup.html"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "content_scripts": [{
    "matches": ["https://rumble.com/*", "https://*.rumble.com/*"],
    "js": [
      "browser-polyfill.js",
      "settings-schema.js",
      "platform.js",
      "core-routing.js",
      "core-selectors.js",
      "core-video-cards.js",
      "core-media.js",
      "content.js"
    ],
    "run_at": "document_start",
    "all_frames": false
  }],
  "web_accessible_resources": [
    "lib/mux.min.js",
    "lib/mediabunny.min.mjs",
    "lib/mediabunny.LICENSE",
    "worker.js",
    "mediabunny-worker.js"
  ]
}
